#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "$runtime_dir/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus"
fi

brave_bin="$(command -v brave-origin 2>/dev/null)" || {
  printf 'brave-session: brave-origin not found; install brave-origin-bin\n' >&2
  exit 127
}

# Match the KDE palette selected by theme-wallpaper, including older login sessions.
export QT_QPA_PLATFORMTHEME=kde
exec "$brave_bin" "$@"
