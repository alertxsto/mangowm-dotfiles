#!/usr/bin/env python3
"""Render Fish, Starship, and Fastfetch from the active Matugen palette."""

from __future__ import annotations

import json
import re
from pathlib import Path

HOME = Path.home()
PALETTE = HOME / ".config/rofi/colors.rasi"
TOKEN = re.compile(r"^\s*([a-z-]+):\s*(#[0-9a-fA-F]{6});")


def colors() -> dict[str, str]:
    result: dict[str, str] = {}
    for line in PALETTE.read_text().splitlines():
        match = TOKEN.match(line)
        if match:
            result[match.group(1)] = match.group(2).lower()
    return result


def bare(value: str) -> str:
    return value.removeprefix("#")


def ansi(value: str, bold: bool = False) -> str:
    red, green, blue = (int(value[index:index + 2], 16) for index in (1, 3, 5))
    weight = "1;" if bold else ""
    return f"\x1b[{weight}38;2;{red};{green};{blue}m"

def fastfetch_color(value: str) -> str:
    red, green, blue = (int(value[index:index + 2], 16) for index in (1, 3, 5))
    return f"38;2;{red};{green};{blue}"


def render_fish(c: dict[str, str]) -> None:
    directory = HOME / ".config/fish/conf.d"
    directory.mkdir(parents=True, exist_ok=True)
    text = f'''# Generated by sync-shell-theme. Source: Matugen.
set -g fish_color_normal {bare(c["on-surface"])}
set -g fish_color_command {bare(c["primary"])} --bold
set -g fish_color_keyword {bare(c["secondary"])}
set -g fish_color_param {bare(c["on-surface"])}
set -g fish_color_option {bare(c["tertiary"])}
set -g fish_color_quote {bare(c["tertiary"])}
set -g fish_color_redirection {bare(c["secondary"])}
set -g fish_color_end {bare(c["primary"])}
set -g fish_color_error {bare(c["error"])} --bold
set -g fish_color_comment {bare(c["on-surface-variant"])} --dim
set -g fish_color_operator {bare(c["secondary"])}
set -g fish_color_escape {bare(c["tertiary"])}
set -g fish_color_autosuggestion {bare(c["outline"])}
set -g fish_color_selection --background={bare(c["primary-container"])}
set -g fish_color_search_match --background={bare(c["surface-container-high"])}
set -g fish_color_valid_path --underline
set -g fish_pager_color_progress {bare(c["on-surface-variant"])}
set -g fish_pager_color_prefix {bare(c["primary"])} --bold
set -g fish_pager_color_completion {bare(c["on-surface"])}
set -g fish_pager_color_description {bare(c["on-surface-variant"])}
set -g fish_pager_color_selected_background --background={bare(c["primary-container"])}
set -gx FZF_DEFAULT_OPTS "$FZF_DEFAULT_OPTS --border=rounded --info=inline-right \\
--color=fg:{c["on-surface"]},bg:-1,hl:{c["primary"]} \\
--color=fg+:{c["on-surface"]},bg+:{c["surface-container-high"]},hl+:{c["primary"]} \\
--color=info:{c["on-surface-variant"]},prompt:{c["primary"]},pointer:{c["tertiary"]} \\
--color=marker:{c["secondary"]},spinner:{c["primary"]},header:{c["on-surface-variant"]} \\
--color=border:{c["outline-variant"]}"
'''
    (directory / "matugen-colors.fish").write_text(text)


def render_starship(c: dict[str, str]) -> None:
    text = f'''# Generated by sync-shell-theme. Source: Matugen.
add_newline = true
command_timeout = 800
format = """[╭─](outline)$os$username$hostname$directory$git_branch$git_status$fill$cmd_duration$status$time\n[╰─](outline)$character"""
palette = "matugen"

[palettes.matugen]
primary = "{c["primary"]}"
on_primary = "{c["on-primary"]}"
secondary = "{c["secondary"]}"
tertiary = "{c["tertiary"]}"
error = "{c["error"]}"
surface = "{c["surface"]}"
surface_high = "{c["surface-container-high"]}"
on_surface = "{c["on-surface"]}"
muted = "{c["on-surface-variant"]}"
outline = "{c["outline-variant"]}"

[os]
disabled = false
style = "bold primary"
format = "[$symbol]($style) "
[os.symbols]
Artix = "■"
Arch = "■"
Linux = "■"

[username]
show_always = true
style_user = "bold on_surface"
format = "[$user]($style)"
[hostname]
ssh_only = false
style = "muted"
format = "[@$hostname]($style) "
[directory]
style = "bold primary"
read_only = " 󰌾"
truncation_length = 3
truncate_to_repo = false
format = "[󰉋 $path]($style)[$read_only]($read_only_style) "
[directory.substitutions]
"Documents" = "󰈙 Documents"
"Downloads" = " Downloads"
"Pictures" = " Pictures"
"Projects" = "󰲋 Projects"

[git_branch]
symbol = " "
style = "tertiary"
format = "[$symbol$branch]($style) "
[git_status]
style = "secondary"
format = "[$all_status$ahead_behind]($style) "
[fill]
symbol = " "
[cmd_duration]
min_time = 1500
style = "muted"
format = "[󱎫 $duration]($style) "
[status]
disabled = false
style = "bold error"
format = "[$symbol$status]($style) "
symbol = "✘ "
[time]
disabled = false
time_format = "%H:%M"
style = "muted"
format = "[ $time]($style)"
[character]
success_symbol = "[❯](bold primary)"
error_symbol = "[❯](bold error)"
vimcmd_symbol = "[❮](bold secondary)"
'''
    (HOME / ".config/starship.toml").write_text(text)


def render_fastfetch(c: dict[str, str]) -> None:
    primary = ansi(c["primary"])
    bright = ansi(c["on-surface"], True)
    muted = ansi(c["on-surface-variant"])
    outline = ansi(c["outline-variant"])
    reset = "\x1b[0m"
    rule = "─" * 26
    config = {
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": {
            "type": "kitty-direct",
            "source": "~/.config/fastfetch/fastfetch-emblem.png",
            "width": 28,
            "height": 14,
            "padding": {"top": 5, "right": 5, "left": 3},
        },
        "display": {
            "color": {"keys": fastfetch_color(c["primary"])},
            "key": {"width": 9},
            "separator": "  ",
            "percent": {
                "type": 9,
                "color": {"green": fastfetch_color(c["tertiary"]), "yellow": fastfetch_color(c["secondary"]), "red": fastfetch_color(c["error"])},
            },
        },
        "modules": [
            "break",
            {"type": "title", "format": f"{bright}{{user-name}}{reset}{muted} @ {reset}{bright}{{host-name}}{reset}"},
            {"type": "custom", "format": f"{primary}■{reset} {muted}ARTIX · MANGO · a Matugen desktop{reset}"},
            "break",
            {"type": "custom", "format": f"{primary}──{reset} {bright}VITALS{reset} {outline}{rule}{reset}"},
            {"type": "cpu", "key": "CPU"},
            {"type": "gpu", "key": "GPU", "detectionMethod": "pci"},
            {"type": "memory", "key": "MEMORY"},
            {"type": "disk", "key": "DISK", "folders": "/"},
            {"type": "battery", "key": "BATTERY"},
            "break",
            {"type": "custom", "format": f"{primary}──{reset} {bright}SYSTEM{reset} {outline}{rule}{reset}"},
            {"type": "os", "key": "OS"},
            {"type": "kernel", "key": "KERNEL"},
            {"type": "wm", "key": "WM"},
            {"type": "shell", "key": "SHELL"},
            {"type": "packages", "key": "PKGS"},
            "break",
            {"type": "custom", "format": f"{primary}──{reset} {bright}SESSION{reset} {outline}{rule}{reset}"},
            {"type": "uptime", "key": "UPTIME"},
            {"type": "display", "key": "DISPLAY", "compactType": "original-with-refresh-rate"},
            {"type": "terminal", "key": "TERM"},
            {"type": "localip", "key": "LOCAL IP", "showIpv4": True, "showIpv6": False},
            "break",
            {"type": "colors", "symbol": "circle", "paddingLeft": 2},
            "break",
        ],
    }
    directory = HOME / ".config/fastfetch"
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "config.jsonc").write_text(json.dumps(config, indent=2) + "\n")


def main() -> None:
    palette = colors()
    render_fish(palette)
    render_starship(palette)
    render_fastfetch(palette)


if __name__ == "__main__":
    main()
