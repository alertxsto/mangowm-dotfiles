/*
 * Shelf: 640px, six applications per page, native Papirus icons at 44px.
 * Opaque panel; no background images, helper processes, or size overrides.
 * Left/Right select apps; Ctrl+B/F move the text cursor (config.rasi).
 * Keep colors.rasi generated by apply-named-theme; do not hardcode a palette.
 */
@import "colors.rasi"

* {
    font: "Noto Sans 10";
    background-color: transparent;
    text-color: @on-surface;
    border-color: @outline-variant;
}

window {
    location: center;
    anchor: center;
    width: 640px;
    padding: 0px;
    border: 1px;
    border-radius: 16px;
    border-color: @outline;
    background-color: @surface;
    children: [mainbox];
}

mainbox {
    padding: 18px 20px 14px;
    spacing: 0px;
    children: [topline, inputbar, message, listview, footer];
}

topline {
    expand: false;
    padding: 0px 0px 12px;
    children: [textbox-heading];
}

textbox-heading {
    content: "Applications";
    font: "Noto Sans Semi-Bold 10";
    text-color: @on-surface;
}

inputbar {
    expand: false;
    orientation: horizontal;
    spacing: 10px;
    padding: 0px 0px 12px;
    border: 0px 0px 1px;
    children: [icon-search, entry];
}

icon-search {
    filename: "system-search-symbolic";
    size: 18px;
    expand: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

entry {
    font: "Noto Sans 13";
    placeholder: "Search applications";
    placeholder-color: @on-surface-variant;
    text-color: @on-surface;
    vertical-align: 0.5;
}

message {
    padding: 6px 0px 0px;
}

message textbox {
    text-color: @on-surface-variant;
}

listview {
    layout: vertical;
    flow: horizontal;
    columns: 6;
    lines: 1;
    fixed-columns: true;
    fixed-height: true;
    dynamic: false;
    cycle: true;
    scrollbar: false;
    spacing: 8px;
    padding: 16px 0px 14px;
}

element {
    orientation: vertical;
    children: [element-icon, element-text];
    spacing: 10px;
    padding: 12px 6px 10px;
    border: 1px;
    border-radius: 10px;
    border-color: transparent;
    background-color: transparent;
    text-color: @on-surface;
    cursor: pointer;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: transparent;
    border-color: transparent;
    text-color: @on-surface;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @surface-container-high;
    border-color: @outline;
    text-color: @on-surface;
}

element-icon {
    size: 44px;
    expand: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    font: "Noto Sans 9";
    expand: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
    highlight: bold;
}

footer {
    expand: false;
    orientation: horizontal;
    padding: 10px 0px 0px;
    border: 1px 0px 0px;
    children: [result-count, footer-spacer, textbox-keys];
}

result-count {
    expand: false;
    orientation: horizontal;
    spacing: 5px;
    children: [textbox-count-label, num-filtered-rows];
}

num-filtered-rows,
textbox-count-label,
textbox-keys {
    expand: false;
    font: "JetBrainsMono Nerd Font 8";
    text-color: @on-surface-variant;
    vertical-align: 0.5;
}

textbox-count-label {
    content: "Results:";
}

footer-spacer {
    expand: true;
}

textbox-keys {
    content: "← →  Select    Enter  Open    Esc  Close";
}
