#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "$runtime_dir/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus"
fi

brave_bin=""
for candidate in brave-beta brave-browser-beta brave-browser brave; do
  if brave_bin="$(command -v "$candidate" 2>/dev/null)"; then
    break
  fi
done
[[ -n "$brave_bin" ]] || {
  printf 'brave-session: no Brave executable found\n' >&2
  exit 127
}

exec "$brave_bin" "$@"
