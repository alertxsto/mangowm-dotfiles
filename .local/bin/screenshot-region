#!/usr/bin/env bash
set -euo pipefail

output_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$output_dir"

geometry="$(slurp)" || exit 0
[[ -n "$geometry" ]] || exit 0
if [[ "${1:-}" == --edit ]]; then
  grim -g "$geometry" - | satty --filename - --resize smart --app-id com.gabm.satty
  exit
fi

output="$output_dir/$(date +'%Y-%m-%d_%H-%M-%S').png"
grim -g "$geometry" - | tee "$output" | wl-copy --type image/png
notify-send 'Screenshot saved' "$output"
