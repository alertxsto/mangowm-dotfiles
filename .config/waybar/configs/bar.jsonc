{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "spacing": 0,
  "height": 35,
  "modules-left": ["custom/artix", "custom/active_window"],
  "modules-center": ["group/center3", "group/workspaces", "group/center2"],
  "modules-right": ["group/right1"],

  "group/workspaces": {
    "orientation": "inherit",
    "modules": [
      "custom/workspace1", "custom/workspace2", "custom/workspace3",
      "custom/workspace4", "custom/workspace5", "custom/workspace6",
      "custom/workspace7", "custom/workspace8", "custom/workspace9"
    ]
  },
  "group/center3": {
    "orientation": "inherit",
    "modules": ["cpu", "memory", "custom/separator#blank", "custom/media"]
  },
  "group/center2": {
    "orientation": "inherit",
    "modules": ["clock", "idle_inhibitor"]
  },
  "group/right1": {
    "orientation": "inherit",
    "modules": [
      "tray", "custom/separator#blank2", "custom/separator#dot", "custom/separator#blank3",
      "custom/mode", "pulseaudio", "network", "bluetooth", "backlight", "power-profiles-daemon", "battery", "custom/notification"
    ]
  },

  "custom/artix": {
    "format": "",
    "tooltip-format": "Applications  •  Super+D",
    "on-click": "rofi -show drun",
    "on-click-right": "kitty"
  },
  "custom/active_window": {
    "exec": "$HOME/.config/waybar/window.sh",
    "return-type": "json",
    "markup": true
  },
  "custom/workspace1": {"exec": "$HOME/.local/bin/workspace-tag 1", "return-type": "json", "interval": 86400, "signal": 1, "on-click": "mmsg dispatch view,1"},
  "custom/workspace2": {"exec": "$HOME/.local/bin/workspace-tag 2", "return-type": "json", "interval": 86400, "signal": 2, "on-click": "mmsg dispatch view,2"},
  "custom/workspace3": {"exec": "$HOME/.local/bin/workspace-tag 3", "return-type": "json", "interval": 86400, "signal": 3, "on-click": "mmsg dispatch view,3"},
  "custom/workspace4": {"exec": "$HOME/.local/bin/workspace-tag 4", "return-type": "json", "interval": 86400, "signal": 4, "on-click": "mmsg dispatch view,4"},
  "custom/workspace5": {"exec": "$HOME/.local/bin/workspace-tag 5", "return-type": "json", "interval": 86400, "signal": 5, "on-click": "mmsg dispatch view,5"},
  "custom/workspace6": {"exec": "$HOME/.local/bin/workspace-tag 6", "return-type": "json", "interval": 86400, "signal": 6, "on-click": "mmsg dispatch view,6"},
  "custom/workspace7": {"exec": "$HOME/.local/bin/workspace-tag 7", "return-type": "json", "interval": 86400, "signal": 7, "on-click": "mmsg dispatch view,7"},
  "custom/workspace8": {"exec": "$HOME/.local/bin/workspace-tag 8", "return-type": "json", "interval": 86400, "signal": 8, "on-click": "mmsg dispatch view,8"},
  "custom/workspace9": {"exec": "$HOME/.local/bin/workspace-tag 9", "return-type": "json", "interval": 86400, "signal": 9, "on-click": "mmsg dispatch view,9"},

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "states": {"warning": 70, "critical": 90},
    "tooltip-format": "CPU {usage}%",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "interval": 2,
    "format": " {used:0.1f} GiB",
    "states": {"warning": 70, "critical": 90},
    "tooltip-format": "Memory {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)",
    "on-click": "kitty -e btop"
  },
  "custom/media": {
    "exec": "$HOME/.config/waybar/media.sh",
    "interval": 2,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },
  "clock": {
    "format": " {:%I:%M %p • %a, %d/%m}     ",
    "format-alt": "{:%A, %d %B %Y}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {"activated": "", "deactivated": ""},
    "tooltip-format-activated": "Idle inhibitor on",
    "tooltip-format-deactivated": "Idle inhibitor off"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "tray": {"icon-size": 16, "spacing": 8},
  "custom/separator#blank": {"format": " ", "interval": "once", "tooltip": false},
  "custom/separator#blank2": {"format": " ", "interval": "once", "tooltip": false},
  "custom/separator#blank3": {"format": " ", "interval": "once", "tooltip": false},
  "custom/separator#dot": {"format": "", "interval": "once", "tooltip": false},
  "custom/mode": {
    "exec": "$HOME/.config/waybar/mode.sh",
    "on-click": "$HOME/.config/waybar/mode.sh toggle",
    "return-type": "json",
    "interval": "once"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {"headphone": "", "default": ["", "", ""]},
    "scroll-step": 5,
    "tooltip-format": "Volume {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "bluetooth": {
    "format": "<span size='11500'>󰂯</span>",
    "format-on": "<span size='11500'>󰂯</span>",
    "format-off": "<span size='11500'>󰂲 OFF</span>",
    "format-disabled": "<span size='11500'>󰂲 OFF</span>",
    "format-connected": "<span size='11500'></span>",
    "format-no-controller": "<span size='11500'>󰂲 N/A</span>",
    "tooltip-format": "Connected devices: {num_connections}",
    "tooltip-format-off": "Bluetooth is off",
    "tooltip-format-disabled": "Bluetooth is disabled",
    "tooltip-format-no-controller": "Bluetooth controller unavailable",
    "on-click": "$HOME/.local/bin/toggle-popup bluetooth-popup"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness {percent}%",
    "scroll-step": 5
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "interface": "wl*",
    "rfkill": true,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮 OFF",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Wi-Fi disconnected",
    "tooltip-format-disabled": "Wi-Fi is off",
    "interval": 5,
    "on-click": "$HOME/.local/bin/toggle-popup network-popup",
    "on-click-right": "kitty --class network-config -e nmtui"
  },
  "battery": {
    "states": {"warning": 20, "critical": 10},
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery {capacity}%",
    "tooltip-format-charging": "Charging {capacity}%"
  }
}
