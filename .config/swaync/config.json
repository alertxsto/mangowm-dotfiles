{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "control-center-exclusive-zone": false,
  "cssPriority": "user",
  "control-center-margin-top": 50,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 360,
  "control-center-height": 500,
  "notification-window-width": 360,
  "keyboard-shortcuts": true,
  "notification-grouping": false,
  "image-visibility": "when-available",
  "transition-time": 160,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "All caught up",
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "slider",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": false,
      "blacklist": []
    },
    "volume": {
      "label": "",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false,
      "expand-per-app": false,
      "empty-list-label": "No active audio",
      "expand-button-label": "",
      "collapse-button-label": "",
      "animation-type": "slide_down",
      "animation-duration": 180
    },
    "slider": {
      "label": "󰃠",
      "cmd_getter": "__HOME__/.local/bin/brightness-control get",
      "cmd_setter": "__HOME__/.local/bin/brightness-control set $value",
      "min": 0,
      "max": 100,
      "min_limit": 5,
      "max_limit": 100,
      "value_scale": 0
    },
    "notifications": {
      "vexpand": true
    }
  }
}
